# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Claude API key (used by main.py, examples/, cli_project_COMPLETE/)
ANTHROPIC_API_KEY=

# Token for Claude Code / Agent SDK auth (generate with `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# Model ID used by the CLI project
CLAUDE_MODEL=claude-haiku-5-5

# Optional: set to 1 if you run the CLI project with uv
USE_UV=

# Optional: public tunnel host for the MCP app
TUNNEL_HOST=

# For Github acction in scenario 4 developer_productivity
GITHUB_TOKEN=
