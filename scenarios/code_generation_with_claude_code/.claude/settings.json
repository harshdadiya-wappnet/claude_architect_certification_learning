{
    "permissions": {
        "deny": [
            "Edit(.env)",
            "Read(.env)",
            "Bash(git push *)",
            "Bash(git commit *)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash",
                        "if": "Bash(rm *)",
                        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block_rm.sh"]
                    }
                ]
            }
        ]
    }
}